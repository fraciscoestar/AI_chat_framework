{
  "name": "@ai-chat-suite/core",
  "version": "0.1.0",
  "description": "An embeddable, modular AI chat suite inspired by Claude.ai",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && node -e \"fs.copyFileSync('src/styles/suite.css', 'dist/styles.css')\"",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "ai",
    "chat",
    "claude",
    "react",
    "nextjs",
    "markdown",
    "katex",
    "mermaid",
    "artifacts",
    "workspace"
  ],
  "author": "",
  "license": "MIT",
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "idb": "^8.0.2",
    "katex": "^0.16.11",
    "lucide-react": "^0.475.0",
    "mermaid": "^11.4.1",
    "react-markdown": "^9.0.3",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "tailwind-merge": "^3.0.1"
  },
  "devDependencies": {
    "@types/katex": "^0.16.7",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsup": "^8.3.6",
    "typescript": "^5.7.3"
  }
}
